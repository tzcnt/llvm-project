; CHECK-NEXT:  ---- Branch Probabilities ----
; CHECK-NEXT:    edge %entry -> %suspend.ret probability is 0x2aaaaaab / 0x80000000 = 33.33%
; CHECK-NEXT:    edge %entry -> %resume probability is 0x2aaaaaab / 0x80000000 = 33.33%
